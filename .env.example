NODE_ENV=production
PORT=3000
GAMEHUB_ALLOWED_ORIGINS=https://gamehub.mhhorizons.com
PREMIUM_SESSION_TICKET_SECRET=replace-with-a-long-random-production-secret
GAMEHUB_PREMIUM_FIREBASE_CREDENTIALS=premium/firebase_credentials/config.js

# Notes:
# - Keep real .env files private. This file is placeholders only.
# - GAMEHUB_ALLOWED_ORIGINS accepts a comma-separated list when multiple domains are needed.
# - GAMEHUB_PREMIUM_FIREBASE_CREDENTIALS must point to a readable file, not a directory.
# - The credential file must contain the existing browser firebaseConfig object:
#   const firebaseConfig = { apiKey: "...", authDomain: "...", projectId: "...", appId: "..." };
# - It may be an absolute path outside the repo on a VPS.
# - Do not commit or serve config.js/serviceAccount.json/raw credential folders.
